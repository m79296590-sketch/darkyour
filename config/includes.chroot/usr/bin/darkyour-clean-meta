#!/bin/sh
# DarkYour: удалить метаданные (геолокацию, модель телефона, автора и т.п.) из файлов.
# Исходники не трогаем — рядом появляются копии с «.cleaned» в имени.
ok=0
fail=0
for f in "$@"; do
	if mat2 "$f" >/dev/null 2>&1; then
		ok=$((ok + 1))
	else
		fail=$((fail + 1))
	fi
done

msg="Очищено файлов: $ok. Рядом созданы копии с «.cleaned» в имени — отправляй их."
[ "$fail" -gt 0 ] && msg="$msg
Не удалось: $fail (такой формат не поддерживается)."

notify-send -i edit-clear-all "Метаданные удалены" "$msg" 2>/dev/null || echo "$msg"
