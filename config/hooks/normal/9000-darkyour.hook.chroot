#!/bin/sh
# DarkYour: финальная настройка системы внутри образа
set -e
echo "I: DarkYour hook start"

# --- Права на наши программы ---
chmod 755 /usr/bin/darkyour-*

# --- Название системы ---
V=$(cat /usr/share/darkyour/version 2>/dev/null || echo "1.0")
rm -f /etc/os-release
cat > /etc/os-release <<EOF
PRETTY_NAME="DarkYour $V"
NAME="DarkYour"
VERSION_ID="$V"
VERSION="$V"
VERSION_CODENAME=trixie
ID=debian
ID_LIKE=debian
HOME_URL="https://github.com/m79296590-sketch/darkyour"
LOGO=darkyour
EOF
printf "%s\n" "DarkYour $V \\n \\l" > /etc/issue
echo "DarkYour $V" > /etc/issue.net

# --- Обои по умолчанию (на случай, если XFCE возьмёт системные) ---
if [ -d /usr/share/images/desktop-base ]; then
	update-alternatives --install /usr/share/images/desktop-base/desktop-background \
		desktop-background /usr/share/backgrounds/darkyour/darkyour.png 100 || true
	update-alternatives --set desktop-background /usr/share/backgrounds/darkyour/darkyour.png || true
fi

# --- Экран входа ---
mkdir -p /etc/lightdm
cat > /etc/lightdm/lightdm-gtk-greeter.conf <<'EOF'
[greeter]
background=/usr/share/backgrounds/darkyour/darkyour.png
theme-name=DarkYour
icon-theme-name=DarkYour
font-name=Noto Sans 11
default-user-image=/usr/share/darkyour/darkyour-logo-128.png
indicators=~host;~spacer;~clock;~spacer;~layout;~power
clock-format=%H:%M
position=50%,center 50%,center
EOF

# --- Фаервол: всё входящее закрыто ---
if [ -f /etc/ufw/ufw.conf ]; then
	sed -i 's/^ENABLED=.*/ENABLED=yes/' /etc/ufw/ufw.conf
	sed -i 's/^DEFAULT_INPUT_POLICY=.*/DEFAULT_INPUT_POLICY="DROP"/' /etc/default/ufw || true
	sed -i 's/^DEFAULT_OUTPUT_POLICY=.*/DEFAULT_OUTPUT_POLICY="ACCEPT"/' /etc/default/ufw || true
	systemctl enable ufw.service || true
fi

# --- Блокировка трекеров и рекламы ---
BL=/usr/share/darkyour/blocklist.hosts
if curl -fsSL --retry 3 -m 120 \
	https://raw.githubusercontent.com/StevenBlack/hosts/master/hosts -o /tmp/hosts.raw; then
	grep -E '^0\.0\.0\.0[[:space:]]+[A-Za-z0-9]' /tmp/hosts.raw \
		| grep -vE '[[:space:]](0\.0\.0\.0|localhost)$' > "$BL" || true
	echo "I: blocklist: $(wc -l < "$BL") доменов"
else
	echo "W: не удалось скачать блок-лист, пропускаю"
fi
rm -f /tmp/hosts.raw
systemctl enable darkyour-blocklist.service || true

# --- Никакой телеметрии ---
apt-get purge -y popularity-contest reportbug 2>/dev/null || true

# --- Firefox: политики приватности ---
if [ -d /usr/lib/firefox-esr ]; then
	mkdir -p /usr/lib/firefox-esr/distribution
	cp /etc/firefox/policies/policies.json /usr/lib/firefox-esr/distribution/policies.json
fi

# --- Установщик Calamares с брендингом DarkYour ---
if [ -d /etc/calamares/branding/debian ]; then
	rm -rf /etc/calamares/branding/darkyour
	cp -a /etc/calamares/branding/debian /etc/calamares/branding/darkyour
	B=/etc/calamares/branding/darkyour/branding.desc
	cp /usr/share/darkyour/darkyour-logo-128.png /etc/calamares/branding/darkyour/darkyour-logo.png
	cp /usr/share/darkyour/darkyour-logo-512.png /etc/calamares/branding/darkyour/darkyour-welcome.png
	sed -i \
		-e 's/^componentName:.*/componentName:  darkyour/' \
		-e 's/^\( *productName:\).*/\1         DarkYour/' \
		-e 's/^\( *shortProductName:\).*/\1    DarkYour/' \
		-e 's/^\( *versionedName:\).*/\1       DarkYour '"$V"'/' \
		-e 's/^\( *shortVersionedName:\).*/\1  DarkYour '"$V"'/' \
		-e 's/^\( *bootloaderEntryName:\).*/\1 DarkYour/' \
		-e 's/^\( *productLogo:\).*/\1         "darkyour-logo.png"/' \
		-e 's/^\( *productIcon:\).*/\1         "darkyour-logo.png"/' \
		-e 's/^\( *productWelcome:\).*/\1      "darkyour-welcome.png"/' \
		-e 's/^\( *sidebarBackground:\).*/\1    "#0d0d14"/' \
		-e 's/^\( *sidebarText:\).*/\1          "#d6d6e0"/' \
		-e 's/^\( *sidebarTextSelect:\).*/\1    "#05060a"/' \
		-e 's/^\( *sidebarTextHighlight:\).*/\1 "#22d3ee"/' \
		-e 's/^\( *sidebarSelect:\).*/\1        "#22d3ee"/' \
		"$B"
	sed -i 's/^branding:.*/branding: darkyour/' /etc/calamares/settings.conf || true
fi

# Ярлык установщика в меню
cat > /usr/share/applications/darkyour-install.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=Установить DarkYour
Comment=Установить систему на компьютер
TryExec=calamares
Exec=sh -c "sudo -E calamares || pkexec calamares"
Icon=/usr/share/darkyour/darkyour-logo-128.png
Terminal=false
Categories=System;
EOF

# Иконка логотипа как системная
mkdir -p /usr/share/icons/hicolor/128x128/apps /usr/share/icons/hicolor/256x256/apps
cp /usr/share/darkyour/darkyour-logo-128.png /usr/share/icons/hicolor/128x128/apps/darkyour.png
cp /usr/share/darkyour/darkyour-logo-256.png /usr/share/icons/hicolor/256x256/apps/darkyour.png
gtk-update-icon-cache -f /usr/share/icons/hicolor 2>/dev/null || true
gtk-update-icon-cache -f /usr/share/icons/DarkYour 2>/dev/null || true


# --- 1.2: Магазин приложений с Flathub ---
if command -v flatpak >/dev/null 2>&1; then
	flatpak remote-add --system --if-not-exists flathub \
		https://dl.flathub.org/repo/flathub.flatpakrepo || echo "W: Flathub не подключился"
fi

# --- 1.2: Тёмный режим для GTK4-приложений ---
command -v dconf >/dev/null 2>&1 && dconf update || true

# Ярлык «Магазин приложений» с понятным названием
if [ -f /usr/share/applications/org.gnome.Software.desktop ]; then
	sed -i 's/^Name\[ru\]=.*/Name[ru]=Магазин приложений/' /usr/share/applications/org.gnome.Software.desktop
	grep -q '^Name\[ru\]=' /usr/share/applications/org.gnome.Software.desktop || \
		sed -i '0,/^Name=/s//Name[ru]=Магазин приложений\nName=/' /usr/share/applications/org.gnome.Software.desktop
fi


# --- 1.2: Экран загрузки ---
if command -v plymouth-set-default-theme >/dev/null 2>&1 && [ -d /usr/share/plymouth/themes/darkyour ]; then
	plymouth-set-default-theme darkyour || true
	mkdir -p /etc/plymouth
	printf "[Daemon]\nTheme=darkyour\nShowDelay=0\n" > /etc/plymouth/plymouthd.conf
	update-initramfs -u -k all || true
fi
# Для установленной системы: экран загрузки и название в меню GRUB
if [ -f /etc/default/grub ]; then
	sed -i 's/^GRUB_CMDLINE_LINUX_DEFAULT=.*/GRUB_CMDLINE_LINUX_DEFAULT="quiet splash"/' /etc/default/grub
	sed -i 's/^GRUB_DISTRIBUTOR=.*/GRUB_DISTRIBUTOR="DarkYour"/' /etc/default/grub
else
	mkdir -p /etc/default/grub.d
	printf 'GRUB_CMDLINE_LINUX_DEFAULT="quiet splash"\nGRUB_DISTRIBUTOR="DarkYour"\n' > /etc/default/grub.d/90-darkyour.cfg
fi


# --- 1.3: Паник-кнопка на Win + Esc ---
KS=/etc/xdg/xfce4/xfconf/xfce-perchannel-xml/xfce4-keyboard-shortcuts.xml
if [ -f "$KS" ] && ! grep -q darkyour-panic "$KS"; then
	sed -i '0,/<property name="custom" type="empty">/s//&\n      <property name="\&lt;Super\&gt;Escape" type="string" value="darkyour-panic"\/>/' "$KS"
fi

# --- 1.3: Игры — Steam (с Proton внутри), Wine для .exe, Lutris ---
export DEBIAN_FRONTEND=noninteractive
dpkg --add-architecture i386
apt-get update || true
echo "steam steam/question select I AGREE" | debconf-set-selections
echo "steam steam/license note ''" | debconf-set-selections
echo "steam-installer steam/question select I AGREE" | debconf-set-selections
apt-get install -y steam-installer || echo "W: Steam не установился"
apt-get install -y wine wine64 wine32:i386 || apt-get install -y wine || echo "W: Wine не установился"
apt-get install -y lutris || echo "W: Lutris нет в репозитории — будет через магазин"
apt-get clean


# --- 1.3: Варианты темы по акцентному цвету ---
T=/usr/share/themes
if [ -d "$T/DarkYour" ]; then
	for v in "Violet:#a78bfa:#c4b5fd" "Red:#f7768e:#ff9fb0" "Green:#4ade80:#86efac"; do
		name="${v%%:*}"; rest="${v#*:}"; col="${rest%%:*}"; hov="${rest#*:}"
		rm -rf "$T/DarkYour-$name"
		mkdir -p "$T/DarkYour-$name/gtk-3.0"
		sed -e "s/@define-color dy_cyan      #22d3ee;/@define-color dy_cyan      $col;/" \
			-e "s/#5ee3f5/$hov/g" "$T/DarkYour/gtk-3.0/gtk.css" > "$T/DarkYour-$name/gtk-3.0/gtk.css"
		ln -sfn ../DarkYour/xfwm4 "$T/DarkYour-$name/xfwm4"
		sed "s/^Name=DarkYour$/Name=DarkYour $name/; s/^GtkTheme=DarkYour$/GtkTheme=DarkYour-$name/" \
			"$T/DarkYour/index.theme" > "$T/DarkYour-$name/index.theme"
	done
fi

echo "I: DarkYour hook done"
