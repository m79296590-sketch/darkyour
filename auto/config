#!/bin/sh
# DarkYour — настройки сборки live-build
set -e

lb config noauto \
	--distribution trixie \
	--architectures amd64 \
	--archive-areas "main contrib non-free non-free-firmware" \
	--debian-installer none \
	--binary-images iso-hybrid \
	--image-name darkyour \
	--iso-application "DarkYour" \
	--iso-publisher "DarkYour Project" \
	--iso-volume "DarkYour" \
	--memtest none \
	--apt-recommends true \
	--bootappend-live "boot=live components quiet splash locales=ru_RU.UTF-8 keyboard-layouts=us,ru keyboard-options=grp:alt_shift_toggle username=darkyour user-fullname=DarkYour hostname=darkyour" \
	"${@}"
